async function renderFaqPage() {
  const faqRoot = document.getElementById("faq-accordion");
  if (!faqRoot) return;

  const faqItems = await window.Sip2SipApp.fetchFaq();

  faqRoot.innerHTML = faqItems.map((item, index) => `
    <div class="faq-item ${index === 0 ? "open" : ""}">
      <button class="faq-question" type="button">
        <span>${item.question}</span>
        <span>+</span>
      </button>
      <div class="faq-answer">
        <p>${item.answer}</p>
      </div>
    </div>
  `).join("");

  faqRoot.querySelectorAll(".faq-question").forEach((button) => {
    button.addEventListener("click", () => {
      const parent = button.closest(".faq-item");
      const isOpen = parent.classList.contains("open");

      faqRoot.querySelectorAll(".faq-item").forEach((item) => item.classList.remove("open"));
      if (!isOpen) parent.classList.add("open");
    });
  });
}

document.addEventListener("DOMContentLoaded", () => {
  renderFaqPage();
});
